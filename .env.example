PORT=3000
NODE_ENV=development

# Origens do frontend autorizadas (separadas por vírgula, sem barra final).
# Vazio = aceita qualquer origem (ok só em desenvolvimento).
# Produção (Render): CORS_ORIGINS=https://seu-front.exemplo.com
CORS_ORIGINS=http://localhost:5173

# Cookies de sessão: deixe VAZIO para o automático (recomendado).
#  - front e API no mesmo site (localhost -> localhost): SameSite=Lax
#  - front em outro domínio (localhost -> https://api.onrender.com): SameSite=None + Secure
# Só defina para forçar um valor: COOKIE_SAMESITE=none  COOKIE_SECURE=true
COOKIE_SAMESITE=
COOKIE_SECURE=

# Somente desenvolvimento: devolve o código OTP na resposta de /auth/forgot-password
DEV_EXPOSE_OTP=true

# Somente desenvolvimento: coleções cruas do json-server em /db/*  (em produção fica desligado)
EXPOSE_RAW_DB=true

# Senha do usuário "murilo" se ele estiver sem senha no db.json (o seed já grava Fimap@2026 para todos)
DEMO_PASSWORD=Fimap@2026

# Opcional: caminho do banco (Render: aponte para um disco persistente)
# DB_FILE=/var/data/db.json
